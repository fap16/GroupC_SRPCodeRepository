#PRE 2016 PIPELINE TSNE GENERATION

setwd("/home/fap16/steered_research_project/r_shiny/matrixes")

library(Seurat)
library(FactoMineR)
library(tidyverse)
library(stringr)

set.seed(42)

# 1. Load combined data
raw_counts <- read.csv("john_counts_with_stage_names.csv", row.names = 1)

# 2. Create Seurat object
organoid <- CreateSeuratObject(
  counts = raw_counts,
  project = "Camp_Replication",
  min.cells = 3,
  min.features = 200
)
# 3. Filter cells 
organoid_cells <- grep(
  "33|35|37|41|65|53|58",
  colnames(organoid),
  value = TRUE
)

organoid <- subset(organoid, cells = organoid_cells)

# 4. Extract stage metadata
organoid$stage <- case_when(
  str_detect(colnames(organoid), "_33") ~ "33d",
  str_detect(colnames(organoid), "_35") ~ "35d",
  str_detect(colnames(organoid), "_37") ~ "37d",
  str_detect(colnames(organoid), "_41") ~ "41d",
  str_detect(colnames(organoid), "_65") ~ "65d",
  str_detect(colnames(organoid), "_53") ~ "53d",
  str_detect(colnames(organoid), "_58") ~ "58d",
)

# 5. Standard preprocessing
organoid <- NormalizeData(organoid)
organoid <- FindVariableFeatures(organoid, selection.method = "vst", nfeatures = 2000)
organoid <- ScaleData(organoid)

# 6. PCA via FactoMineR 
scaled_matrix <- t(as.matrix(
  GetAssayData(organoid, layer = "scale.data")[VariableFeatures(organoid), ]
))

res.pca <- PCA(scaled_matrix, ncp = 15, graph = FALSE)


# 7. Extract significant genes 
pca_stats <- dimdesc(res.pca, proba = 0.001)

paper_features <- c()
for (i in 1:15) {
  pc_name <- paste0("Dim.", i)
  if (!is.null(pca_stats[[pc_name]]$quanti)) {
    genes_pc <- rownames(pca_stats[[pc_name]]$quanti)[
      1:min(50, nrow(pca_stats[[pc_name]]$quanti))
    ]
    paper_features <- c(paper_features, genes_pc)
  }
}
paper_features <- unique(paper_features

# 8. Inject PCA into Seurat
pca_embeddings <- res.pca$ind$coord
colnames(pca_embeddings) <- paste0("PC_", 1:15)

organoid[["pca"]] <- CreateDimReducObject(
  embeddings = pca_embeddings,
  key = "PC_",
  assay = "RNA"
)

# 9. run t-SNE 
organoid <- RunTSNE(
  organoid,
  features = paper_features,
  dims = 1:15,
  perplexity = 5,
  check_duplicates = FALSE
)


# 10. Clustering

organoid <- FindNeighbors(organoid, dims = 1:15)
organoid <- FindClusters(organoid, resolution = 1.0)
organoid <- BuildClusterTree(organoid, dims = 1:15, reorder = TRUE)

# 11. Rename clusters based on markers 
organoid <- RenameIdents(organoid, 
                         "3" = "Dorsal Forebrain Neurons",  
                         "2" = "Forebrain NPCs",           
                         "5" = "Ventral Forebrain NPCs",    
                         "0" = "Midbrain Progenitors",      
                         "4" = "Midbrain Neurons",          
                         "1" = "Midbrain-Hindbrain", 
                         "6" = "Early Forebrain Progs", 
                         "7" = "Mesenchymal Cells",         
                         "8" = "Forebrain-Specific NPCs", 
                         "9" = "Late Midbrain Progs"
)

# 12. create tSNE plot
tsne_df <- as.data.frame(Embeddings(organoid, "tsne"))
tsne_df$cluster <- Idents(organoid)
tsne_df$stage <- organoid$stage

ggplot(tsne_df, aes(tSNE_1, tSNE_2)) +
  stat_ellipse(aes(fill = cluster), geom = "polygon", alpha = 0.2) +
  geom_point(aes(shape = stage), color = "black", size = 2) +
  scale_shape_manual(values = c(
    "33d" = 16,
    "35d" = 17,
    "37d" = 15,
    "41d" = 18,
    "53d" = 3,
    "58d" = 4,
    "65d" = 8,
    "NA" = 9
  )) +
  theme_classic() +
  labs(fill = "Cluster", shape = "Stage") +
  ggtitle("Recreation of Camp et al Figure 3d: Pre-2016")
