# ==============================
# Seurat workflow for post-2016 data
# ==============================

# 1. Load packages
library(Seurat)
library(ggplot2)
library(dplyr)

# 2. Read count matrix
counts <- read.csv(
  "Counts_matrix_post2016.csv",
  row.names = 1,
  check.names = FALSE
)

# 3. Convert to matrix
counts <- as.matrix(counts)

# 4. Check dimensions and names
print(dim(counts))
print(head(rownames(counts)))
print(head(colnames(counts)))

# 5. Create Seurat object
seurat_obj <- CreateSeuratObject(
  counts = counts,
  project = "Post2016",
  min.cells = 3,
  min.features = 200
)

# 6. Add mitochondrial percentage
# Use ^MT- for human, ^mt- for mouse
seurat_obj[["percent.mt"]] <- PercentageFeatureSet(seurat_obj, pattern = "^MT-")

# 7. QC plots
VlnPlot(
  seurat_obj,
  features = c("nFeature_RNA", "nCount_RNA", "percent.mt"),
  ncol = 3
)

# 8. Filter cells
seurat_obj <- subset(
  seurat_obj,
  subset = nFeature_RNA > 200 &
    nFeature_RNA < 6000 &
    percent.mt < 10
)

# 9. Normalise data
seurat_obj <- NormalizeData(seurat_obj)

# 10. Find variable features
seurat_obj <- FindVariableFeatures(
  seurat_obj,
  selection.method = "vst",
  nfeatures = 2000
)

# 11. Scale data
seurat_obj <- ScaleData(seurat_obj)

# 12. Run PCA
seurat_obj <- RunPCA(
  seurat_obj,
  features = VariableFeatures(object = seurat_obj)
)

# 13. Visualise PCA
print(ElbowPlot(seurat_obj))
print(DimPlot(seurat_obj, reduction = "pca"))

# 14. Find neighbours and clusters
seurat_obj <- FindNeighbors(seurat_obj, dims = 1:20)
seurat_obj <- FindClusters(seurat_obj, resolution = 0.5)

# 15. Run UMAP
seurat_obj <- RunUMAP(seurat_obj, dims = 1:20)

# 16. Plot UMAP
p_umap <- DimPlot(seurat_obj, reduction = "umap", label = TRUE) +
  ggtitle("UMAP Clusters: Post2016")
print(p_umap)

# 17. Save UMAP
ggsave("UMAP_clusters_post2016.png", plot = p_umap, width = 8, height = 6)

# 18. Find marker genes for all clusters
markers_all <- FindAllMarkers(
  seurat_obj,
  only.pos = TRUE,
  min.pct = 0.25,
  logfc.threshold = 0.25
)

# 19. Get top 10 markers per cluster
top_markers <- markers_all %>%
  group_by(cluster) %>%
  slice_max(order_by = avg_log2FC, n = 10)

print(top_markers)

# 20. Save marker results
write.csv(markers_all, "all_cluster_markers_post2016.csv", row.names = FALSE)
write.csv(top_markers, "top10_markers_per_cluster_post2016.csv", row.names = FALSE)

# 21. Heatmap of top markers
top20_genes <- markers_all %>%
  group_by(cluster) %>%
  slice_max(order_by = avg_log2FC, n = 20) %>%
  pull(gene) %>%
  unique()

p_heatmap <- DoHeatmap(seurat_obj, features = top20_genes) + NoLegend()
print(p_heatmap)

ggsave("Heatmap_top_markers_post2016.png", plot = p_heatmap, width = 12, height = 10)

# 22. Save Seurat object
saveRDS(seurat_obj, file = "seurat_post2016.rds")
)
