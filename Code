      "Clusters", #title
      br(),
      fluidRow(
        column(#first section of page - plot control option selection
          4, #4/12 width
          card(
            card_header("Plot controls"), #title
            #combination of both selectInput, sliderInput & checkboxInput = all allow user to interact with app & create responsive result according to options provided from the data
            selectInput("embedding", "Embedding", choices = c("UMAP", "tSNE"), selected = "UMAP"), #embedding = input, Embedding = Label -> input, label of UI; access to user choice of UMAP or tSNE
            selectInput("colour_by", "Colour by", choices = c("cluster", "cell_type", "dataset"), selected = "cluster"), #highlights method by which the points are coloured - according to clusters
            sliderInput("pt_size", "Point size", min = 0.5, max = 4, value = 1.5, step = 0.1), #allows adjustment of scatter point size via slider - has min & max range 
