# app.R
# Starter Shiny app (mock data) for:
# - Querying single-gene expression by name
# - Visualising cell clusters with simple interactive controls
#
# Swap out the mock data loaders with real data later.

library(shiny)
library(bslib)
library(ggplot2)
library(plotly)
library(dplyr)
library(stringr)

# ----------------------------
# Mock data generator (REMOVE later)
# ----------------------------
make_mock_data <- function(n_cells = 2000, genes = c("SOX2", "EOMES", "NEUROD6", "PAX6", "TBR1")) {
  set.seed(42)
  
  clusters <- paste0("c", 1:8)
  cell_types <- c("AP", "BP", "Neuron", "Mesenchymal")
  datasets <- c("Fetal", "Organoid")
  
  cells <- tibble(
    cell_id   = paste0("cell_", seq_len(n_cells)),
    cluster   = sample(clusters, n_cells, replace = TRUE),
    cell_type = sample(cell_types, n_cells, replace = TRUE, prob = c(0.35, 0.10, 0.45, 0.10)),
    dataset   = sample(datasets, n_cells, replace = TRUE)
  )
  
  # Make two embeddings to support the "optional" embedding switch
  cells <- cells %>%
    mutate(
      UMAP_1 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.25,
      UMAP_2 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.15,
      TSNE_1 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.20,
      TSNE_2 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.10
    )
  
  # Long format expression table:
  # one row per (cell, gene) — ok for mock; real data should be precomputed summaries or sparse matrix.
  expr <- expand.grid(cell_id = cells$cell_id, gene = genes, stringsAsFactors = FALSE) %>%
    as_tibble() %>%
    mutate(
      # Fake "expression" with some cluster/cell_type effects
      expr = pmax(
        0,
        rnorm(n(), mean = 0.6, sd = 0.7) +
          ifelse(gene %in% c("SOX2", "PAX6") & cells$cell_type[match(cell_id, cells$cell_id)] == "AP", 1.2, 0) +
          ifelse(gene == "EOMES" & cells$cell_type[match(cell_id, cells$cell_id)] == "BP", 1.0, 0) +
          ifelse(gene %in% c("NEUROD6", "TBR1") & cells$cell_type[match(cell_id, cells$cell_id)] == "Neuron", 1.1, 0)
      )
    )
  
  list(cells = cells, expr = expr, genes = genes)
}

mock <- make_mock_data()

