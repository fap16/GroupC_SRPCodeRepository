# ----------------------------
# Server
# ----------------------------
server <- function(input, output, session) {
  
  # Data "access layer" (swap this later with real loaders)
  cells <- reactiveVal(mock$cells)
  expr  <- reactiveVal(mock$expr)
  genes <- reactiveVal(mock$genes)
  
  # ----- Gene query -----
  gene_data <- eventReactive(input$go_gene, {
    g <- str_trim(input$gene)
    
    validate(
      need(nzchar(g), "Please enter a gene name."),
      need(g %in% genes(), paste0("Gene not found: '", g, "'."))
    )
    
    # Join expression for gene onto cells
    df <- cells() %>%
      left_join(expr() %>% filter(gene == g), by = "cell_id")
    
    validate(need(!all(is.na(df$expr)), "No expression data available for this gene."))
    
    df
  }, ignoreInit = TRUE)
  
  output$gene_status <- renderUI({
    req(input$gene)
    tags$div(
      class = "text-muted",
      paste0("Selected gene: ", input$gene, " (mock dataset)")
    )
  })
  
  output$gene_plot_out <- renderPlot({
    df <- gene_data()
    g <- input$gene
    
    if (input$gene_plot == "violin") {
      ggplot(df, aes(x = cluster, y = expr)) +
        geom_violin(trim = TRUE) +
        geom_boxplot(width = 0.15, outlier.size = 0.5) +
        labs(title = paste0("Expression of ", g, " by cluster"), x = "Cluster", y = "Expression") +
        theme_minimal()
    } else {
      # Feature plot on selected embedding (default UMAP)
      ggplot(df, aes(x = UMAP_1, y = UMAP_2, colour = expr)) +
        geom_point(size = 1, alpha = 0.7) +
        labs(title = paste0("Embedding expression map: ", g), x = "UMAP_1", y = "UMAP_2", colour = "Expr") +
        theme_minimal()
    }
  })
  
  output$gene_table_out <- renderTable({
    df <- gene_data()
    df %>%
      group_by(cluster) %>%
      summarise(
        avg_expr = mean(expr, na.rm = TRUE),
        pct_expr = mean(expr > 0, na.rm = TRUE) * 100,
        n_cells  = dplyr::n(),
        .groups = "drop"
      ) %>%
      arrange(desc(avg_expr))
  }, digits = 3)
  
  # ----- Cluster plot (optional) -----
  output$cluster_plot <- renderPlotly({
    df <- cells()
    
    xcol <- if (input$embedding == "UMAP") "UMAP_1" else "TSNE_1"
    ycol <- if (input$embedding == "UMAP") "UMAP_2" else "TSNE_2"
    
    p <- ggplot(df, aes_string(x = xcol, y = ycol, colour = input$colour_by,
                               text = "paste('Cell:', cell_id, '<br>Cluster:', cluster, '<br>Type:', cell_type, '<br>Dataset:', dataset)")) +
      geom_point(size = input$pt_size, alpha = input$alpha) +
      labs(
        title = paste0(input$embedding, " clusters coloured by ", input$colour_by),
        x = xcol, y = ycol
      ) +
      theme_minimal()
    
    gg <- ggplotly(p, tooltip = "text")
    
    if (!isTRUE(input$show_legend)) {
      gg <- gg %>% layout(showlegend = FALSE)
    }
    
    gg
  })
}

shinyApp(ui, server)
