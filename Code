#2. Generate RNA-seq Data 
#----------------------------
# Mock data generator (This section is unneeded --> will be replaced by real data input from the analysis) 
# ----------------------------

#Step 1 - create a function that randomly generates RNA-seq data using the 'function' command'
  #Name of function = make_mock_data 
  #n_cells = sets number of cells (aka number of repetition to 2000), genes =c() - creates a vector of gene names. 
    #cell names will be replaced with the study genes
  #set.seed - random number generator - HOWEVER, guarantees that the same random values are generated every time the code is run (reproducible/fixed)
    #number of set.seed() is any number preferred, serves as the seed
make_mock_data <- function(n_cells = 2000, genes = c("SOX2", "EOMES", "NEUROD6", "PAX6", "TBR1")) {
  set.seed(42)

  #Step 2 - cell cluster names are automatically created - begin with c, numbered 1-8; paste0 function automatically separates using a space.  
  clusters <- paste0("c", 1:8)
  #defines cell types in a vector 
  cell_types <- c("AP", "BP", "Neuron", "Mesenchymal")
  #separates data into 2 types 
  datasets <- c("Fetal", "Organoid")
  
  #Step 3 - cell dataframe created, and cells are assigned IDs before being randomly assigned to different clusters, cell types & datasets (MOCK DATA)  
  cells <- tibble(
    cell_id   = paste0("cell_", seq_len(n_cells)),
    cluster   = sample(clusters, n_cells, replace = TRUE), #replace = TRUE - avoids repetition 
    cell_type = sample(cell_types, n_cells, replace = TRUE, prob = c(0.35, 0.10, 0.45, 0.10)), #0.35-0.10 - probabilities are used to reflect typical cell type proportions 
    dataset   = sample(datasets, n_cells, replace = TRUE)
  )
  
  #Step 4 - cell dataframe/tibble is fed via a pipe, in order to modify it
    #random numbers of cells (depending on (now labelled) cluster number) separated - aka clusters separated
      #forms UMAP1 & 2, TSNE 1 & 2 for each cell- allows visualization as 2d coordinates (dots)
      #multiplying by 0.25-0.10 allows for clusters to shift apart slightly
  cells <- cells %>%
    mutate(
      UMAP_1 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.25,
      UMAP_2 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.15,
      TSNE_1 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.20,
      TSNE_2 = rnorm(n_cells) + as.numeric(factor(cluster)) * 0.10
    ) # tSNE = t-distributed Stochastic Neighbor Embedding - allows for 2d visualisation of gene expression 
  
  #Step 5: gene expression table formed (mock data)
    # will create all possible gene-cell combinations 
  # one row per (cell, gene) — ok for mock data; real data should be precomputed summaries or sparse matrix.
  expr <- expand.grid(cell_id = cells$cell_id, gene = genes, stringsAsFactors = FALSE) %>% #not factor variables - aka limited/fixed 
    as_tibble() %>% # creates a dataframe
    mutate(
      # Creates a new column - fake "expression" data with some cluster/cell_type effects
      expr = pmax(
        0,
        #sets random guidelines 
        rnorm(n(), mean = 0.6, sd = 0.7) +
          #if-else is used return values according to the guidelines
            #IF gene is SOX2/PAX6 AND Apical Progenitor cell = add 1.2 ELSE add 0 
            #IF genes is EOMES and Basal Progenitor = add 1,0 ELSE add 0 
            #IF gene is NEUROD6/TBR1 and Neuron, add 1.1, ELSE add 0 
              #categorises cell types using match function 
          ifelse(gene %in% c("SOX2", "PAX6") & cells$cell_type[match(cell_id, cells$cell_id)] == "AP", 1.2, 0) +
          ifelse(gene == "EOMES" & cells$cell_type[match(cell_id, cells$cell_id)] == "BP", 1.0, 0) +
          ifelse(gene %in% c("NEUROD6", "TBR1") & cells$cell_type[match(cell_id, cells$cell_id)] == "Neuron", 1.1, 0)
      )
    )
  
  #Step 6: list object created - container of 3 elements, which creates them as objects in environment 
    #name=object
  list(cells = cells, expr = expr, genes = genes)
}

#Step 7: reassign initial function into mock
  #mock$cells will show the cell data 
#function will now run to create mock data 
mock <- make_mock_data()

#OVERVIEW - mock function creates 4 main datatypes: 
  #1. cells dataframe (tibble) - contains cell metadata & embeds coordinates; used for: UMAP plotting, clustering/cell type colour coding & cell filtering 
  #2. expression (expr) dataframe (tibble) - contains cell_id, gene and matching expression levels (numeric val); used to plot gene expression, make violin plots and colour code expression. Also used to calculate summaries.
  #3. genes vector - just a list of genes used for shiny drop downs & subsetting expression. Creates ref list of all the gene types  
  #4. list which combines all elements into one object (within the environment)

#PLAN - for real, raw data 
  #1. raw data of the cell count will be inputted - as a csv: genes as rows, cells as columns and each value being a raw count
  #2. A Seurat object will be created, storing the raw counts, cell clusters, metadata(id, cell types), embeddings (aka UMAP & TSNE) 
  #3. Data is refined (repeats, low quality data removed), and data is normalized
  #4. Key varying genes are found - reduces noise and focuses on significant/meaningful differences 
  #5. Scale the data for gene expression 
  #6. Creation of cell clusters
  #7. Embedding for visualization are created - UMAP
  #8. Data will be extracted to form dataframes & eventually an object 

