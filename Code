  #apply theme - package allows access to any theme; also sets title within the title panel
  theme = shinytheme("flatly"),
  titlePanel("Cerebral Organoid scRNA-seq Explorer (Starter)"),
  
  #Step 2 - Creation of TAB 1 - Gene Query: overview of expression & violin plot visual w/ associated dataset 
    # Contains 2 sections using card layout - Search & Results 
    # Essentially horizontal card layout to make up the main page content 
  tabsetPanel(
    tabPanel(
      "Gene query",
      br(),
      fluidRow(
        column( # this column/section serves to create the SEARCH QUERY
          4, #width 4/12 size 
          card( #bootstrap style box panel sections 
            card_header("Search"), #section name = Search 
            selectizeInput( # function for a searchable dropdown input 
              "gene", #input ID used for server logic (to connect)
              "Gene symbol",
              choices = mock$genes, #creates options generated from the genes vector
              selected = "SOX2", # sets a default 'selected' value 
              options = list(placeholder = "Type a gene (e.g., SOX2)", create = FALSE) #sets typical text to be found in search bar 
            ),
            radioButtons( #allows selection from an exclusive list - set and can be used for future reactive behaviour 
              "gene_plot", #input for exclusive gene list
              "Gene plot type", #title of button/ indicates selection option  
              choices = c("Violin by cluster" = "violin", "Expression on embedding" = "feature"), #types of plots & titles - violin OR UMAP
              selected = "violin" #default choice
            ),
            actionButton("go_gene", "Search", class = "btn-primary") # Search button for specific gene of choice - triggers an action in server logic (controlled reactivity); class - bootstrap styling
          )
        ),
        column( #second section (main) on interface 
          8, #8/12 width 
          card(
            card_header("Results"),
            uiOutput("gene_status"), #dynamic UI - allows automatic response - either Gene Found/ Not Found
            plotOutput("gene_plot_out", height = "380px"), #outputs plot according to type selected (programmed above - violin/UMAP)
            br(), #line break, serves visual purpose of spacing 
            tableOutput("gene_table_out") #produces a table underneath of specific expression values
          )
        )
      )
    ),
    
    #Step 3 - Creation of TAB 2 - Clusters - user interaction with plot controls & creation of overall gene expression clusters in either UMAP or tNSE
