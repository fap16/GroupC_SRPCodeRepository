            checkboxInput("show_legend", "Show legend", value = TRUE)
          )
        ),
        column( #second section of page - Cluster Plot Visualization 
          8, #8/12 width 
          card(
            card_header("Cluster view"),
            plotlyOutput("cluster_plot", height = "520px") #uses plotly package to create interactive (hover) plot  
          )
        )
      )
    ),
    
    #Step 4 - Creation of TAB 3 - About section
    tabPanel(
      "About",
      br(),
      card(
        card_header("Purpose of this Platform"),
        p("This is an app used to represent the gene expression of fetal neocortex developmental genes in  celebral organoids."),
        tags$ul( #creates an unordered list
          tags$li("Gene query tab: type a gene name and see expression by cluster or on an embedding."),
          tags$li("Clusters tab: interact with a cluster scatter (embedding switch + colour/size/alpha)."),
          tags$li("Real scRNA-seq-derived input is used, method for analysis followed from study by Camp et al. 2015.")
        ),
