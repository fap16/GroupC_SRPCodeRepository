# ----------------------------
# Step 6 - Server Set up & Connection
# ----------------------------

#1. Define the server function for the  webApp
server <- function(input, output, session) {
  #input - values input from the user via the UI, ie search bar, sliders, buttons
  #output - any objects created in the UI, ie plots/ cell data tables 
  #session - refers to any session specific information - not really relevant here as website uses fixed data 
  
#2. Display the selected gene
  
  #Create a dynamic UI element in HTML on the server - gene_status 
  #allows data created from input (so the output) to be stored; 
  #will also be live updated to display the currently selected gene name 
  output$gene_status <- renderUI({ #render = ensures Shiny recognizes the output as UI HTML not a plot figure 
    req(input$gene) #ensures the gene does exist in the list
    tags$div(class = "text-muted", paste0("Selected gene: ", input$gene))
  }) #displays selected gene in a div block on the page 
  
#renderPlot() → creates a plot
#renderTable() → creates a table
#renderUI() → creates HTML/UI elements dynamically
  
#3. Create interaction - reactive output to input   
  # Display specific cell expression for selected gene and join to UMAP + cluster metadata
    #creates table underneath plot for selected gene ONLY
  gene_data <- eventReactive(input$go_gene, { #ensures reaction (change) only occurs due to input 
    g <- trimws(input$gene) #removes any spaces from gene name in input for accurate searching

    #4. Validate the input 
    validate(
      need(nzchar(g), "Please enter a gene name."), # ensures gene name search is not empty (input)
      need(g %in% genes_vec, paste0("Gene not found: '", g, "'.")) #ensures selected gene exists in the gene dataset
    )
    
    #5. *** Extract specific gene expression data to fill gene_data table
    FetchData(seurat_obj, vars = g) %>% #extracts values from the gene 'g' metadata in the seurat object
      rownames_to_column("cell_id") %>% #converts cell id row names into a column = cell Ids
      rename(expr = !!g) %>% #renames gene name column to expression; !!g allows dynamic reference to data 
      left_join(cells_df, by = "cell_id") #connects gene expression data with cell metadata = adds UMAP and cluster info
  }, ignoreInit = TRUE) #ensures the plots do not appear automatically - only after button input 
  
  
  #6. Gene Plot Output 
  
  #Creates a dynamic UI output to contain the plots based on input
  output$gene_plot_out <- renderPlot({
    df <- gene_data()
    g <- input$gene
    
    #Run if user input selects Violin plots 
    if (input$gene_plot == "violin") {
      ggplot(df, aes(x = cluster, y = expr)) +
        geom_violin(trim = TRUE) +
        geom_boxplot(width = 0.15, outlier.size = 0.5) +
        theme_minimal() +
        labs(title = paste("Expression of", g, "by cluster"),
             x = "Cluster", y = "Expression")
    } else {
      validate(need(all(c("UMAP_1", "UMAP_2") %in% names(df)), "UMAP coordinates not available."))
      ggplot(df, aes(x = UMAP_1, y = UMAP_2, colour = expr)) +
        geom_point(size = 1.2, alpha = 0.75) +
        theme_minimal() +
        labs(title = paste("UMAP expression:", g),
             x = "UMAP_1", y = "UMAP_2", colour = "Expr")
    }
  })
  
  output$gene_table_out <- renderTable({
    df <- gene_data()
    
    df %>%
      group_by(cluster) %>%
      summarise(
        avg_expr = mean(expr, na.rm = TRUE),
        pct_expr = mean(expr > 0, na.rm = TRUE) * 100,
        n_cells  = n(),
        .groups = "drop"
      ) %>%
      arrange(desc(avg_expr))
  }, digits = 3)
  
  output$cluster_plot <- renderPlotly({
    validate(need(all(c("UMAP_1", "UMAP_2", "cluster", "cell_id") %in% names(cells_df)),
                  "cell_metadata.rds is missing required columns."))
    
    p <- ggplot(
      cells_df,
      aes(
        x = UMAP_1, y = UMAP_2,
        colour = cluster,
        text = paste("Cell:", cell_id, "<br>Cluster:", cluster)
      )
    ) +
      geom_point(size = input$pt_size, alpha = input$alpha) +
      theme_minimal() +
      labs(title = "UMAP clusters", x = "UMAP_1", y = "UMAP_2", colour = "Cluster")
    
    gg <- ggplotly(p, tooltip = "text")
    if (!isTRUE(input$show_legend)) gg <- gg %>% layout(showlegend = FALSE)
    gg
  })
}

shinyApp(ui, server)
